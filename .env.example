# ==========================================
# MULTI-PROVIDER LLM ADAPTER CONFIGURATION
# ==========================================

# Lựa chọn LLM Provider: "gemini", "openai", "anthropic", "openrouter", hoặc "mock" (offline)
LLM_PROVIDER=gemini

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-3.6-flash

# OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here
# LLM_MODEL=gpt-4o-mini

# Anthropic API Key
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# LLM_MODEL=claude-3-5-haiku-20241022

# MCP Configuration
MCP_SERVER_HOST=localhost
MCP_SERVER_PORT=8000

# Agentic AI Admin Prototype (không commit giá trị thật)
# Tạo hash: python -c "from passlib.context import CryptContext; print(CryptContext(schemes=['bcrypt']).hash('your-admin-password'))"
ADMIN_PASSWORD_HASH=replace_with_bcrypt_hash
# Tạo chuỗi ngẫu nhiên dài: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=replace_with_a_long_random_secret
# development cho localhost; production sẽ bật Secure cookie
APP_ENV=development
